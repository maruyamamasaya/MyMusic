{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymusic.local/schemas/track-feature-v1.json",
  "title": "MyMusic Track Feature Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisVersion", "generatedAt", "tracks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "fileSize", "duration", "features"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the analyzed library root; absolute paths and dot path components are invalid."
        },
        "fileSize": { "type": "integer", "minimum": 1 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "modificationDate": { "type": "string", "format": "date-time" },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "Optional SHA-256 hexadecimal reserved for future exact matching."
        },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "album": { "type": "string" },
        "features": { "$ref": "#/$defs/features" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tempo": { "type": "number", "exclusiveMinimum": 0 },
        "energy": { "$ref": "#/$defs/score" },
        "piano": { "$ref": "#/$defs/score" },
        "ambient": { "$ref": "#/$defs/score" },
        "electronic": { "$ref": "#/$defs/score" },
        "drumAndBass": { "$ref": "#/$defs/score" },
        "aggressive": { "$ref": "#/$defs/score" },
        "calm": { "$ref": "#/$defs/score" },
        "bright": { "$ref": "#/$defs/score" },
        "dark": { "$ref": "#/$defs/score" },
        "vocal": { "$ref": "#/$defs/score" },
        "instrumental": { "$ref": "#/$defs/score" },
        "additional": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "energy", "piano", "ambient", "electronic", "drumAndBass", "aggressive",
                "calm", "bright", "dark", "vocal", "instrumental"
              ]
            }
          },
          "additionalProperties": { "$ref": "#/$defs/score" }
        }
      },
      "anyOf": [
        { "required": ["tempo"] },
        { "required": ["energy"] },
        { "required": ["piano"] },
        { "required": ["ambient"] },
        { "required": ["electronic"] },
        { "required": ["drumAndBass"] },
        { "required": ["aggressive"] },
        { "required": ["calm"] },
        { "required": ["bright"] },
        { "required": ["dark"] },
        { "required": ["vocal"] },
        { "required": ["instrumental"] },
        { "required": ["additional"] }
      ]
    }
  }
}
